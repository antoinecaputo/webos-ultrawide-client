{
  "name": "com.antoine.ultrawideclient",
  "version": "1.2.2",
  "description": "Unofficial ultrawide webOS client for Jellyfin servers",
  "scripts": {
    "check": "ares-package --check",
    "package": "ares-package --no-minify --outdir build/ services frontend",
    "clean": "rm -rf build/",
    "deploy": "ares-install build/com.antoine.ultrawideclient_${npm_package_version}_all.ipk",
    "launch": "ares-launch com.antoine.ultrawideclient",
    "manifest": "node tools/gen-manifest.js build/com.antoine.ultrawideclient.manifest.json",
    "version": "node tools/sync-version.js && git add frontend/appinfo.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Jellyfin contributors and community fork contributors",
  "license": "MPL-2.0",
  "devDependencies": {
    "@webosose/ares-cli": "^2.4.0"
  }
}
